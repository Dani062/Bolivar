      "name": "4. Oportunidades - crear (POST)",
      "item": [
        {
          "name": "4.1 POST /oportunidades - crear (admin, 201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "(() => {",
                  "    pm.test('Status es 201 Created', () => pm.response.to.have.status(201));",
                  "    const data = pm.response.json();",
                  "    pm.test('Mensaje de creada', () => pm.expect(data.mensaje).to.eql('Oportunidad creada.'));",
                  "    pm.test('Guarda los datos enviados', () => {",
                  "        pm.expect(data.oportunidad.titulo).to.eql('Curso de prueba Postman');",
                  "        pm.expect(data.oportunidad.cupos).to.eql(25);",
                  "        pm.expect(data.oportunidad.clase).to.eql('academica');",
                  "        pm.expect(data.oportunidad.municipio).to.eql('Todo Bolívar');",
                  "    });",
                  "    pm.test('Queda con estado activa y con id de Mongo', () => {",
                  "        pm.expect(data.oportunidad.estado).to.eql('activa');",
                  "        pm.expect(data.oportunidad._id).to.be.a('string').and.not.empty;",
                  "    });",
                  "    pm.collectionVariables.set('idOportunidad', data.oportunidad._id);",
                  "})();"
                ],
                "type": "text/javascript"
              }
            }
          ],
