# Copia este archivo como .env y completa los valores.
#   cp .env.example .env

# Puerto del servidor.
PORT=4000

# URL de conexión a MongoDB.
# Local:  mongodb://127.0.0.1:27017/bolivar_aprende_y_trabaja
# Atlas:  mongodb+srv://<usuario>:<clave>@<cluster>.mongodb.net/bolivar_aprende_y_trabaja
MONGO_URI=mongodb+srv://TU_USUARIO:TU_CLAVE@TU_CLUSTER.mongodb.net/bolivar_aprende_y_trabaja

# Secreto con el que se firman los tokens JWT. Ponle algo largo e inventado.
JWT_SECRET=escribe_aqui_cualquier_texto_largo_e_inventado_123

# Vigencia del token (7d = 7 días).
JWT_EXPIRES_IN=7d

# Máximo de intentos de login/registro en 15 minutos (protección contra
# fuerza bruta). Súbelo si vas a repetir muchas veces la colección de Postman.
RATE_LIMIT_MAX=50

# Administrador que crea "npm run seed" y "npm run semilla".
ADMIN_EMAIL=admin@bolivar.com
ADMIN_PASSWORD=admin123
