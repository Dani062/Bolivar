{
  "name": "bolivar-aprende-y-trabaja-backend",
  "version": "1.0.0",
  "description": "Backend de la app Bolivar Aprende y Trabaja",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "semilla": "node scripts/semilla.js",
    "test": "jest --detectOpenHandles --runInBand",
    "test:postman": "newman run postman/Bolivar-Aprende-y-Trabaja.postman_collection.json -e postman/Bolivar-Entorno-Local.postman_environment.json",
    "reporte:postman": "newman run postman/Bolivar-Aprende-y-Trabaja.postman_collection.json -e postman/Bolivar-Entorno-Local.postman_environment.json -r cli,html --reporter-html-export postman/Reporte-pruebas-Postman.html"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "newman": "^6.2.3",
    "newman-reporter-html": "^1.0.5",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "//": "La base de datos está en Atlas (por internet), así que las pruebas necesitan más margen que los 5 segundos por defecto.",
    "testTimeout": 30000,
    "testPathIgnorePatterns": [
      "/node_modules/"
    ]
  }
}
